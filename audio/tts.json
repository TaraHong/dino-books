{
 "ank/00": {
  "text": "갑옷이 단단한 안킬로사우루스",
  "cfg": "F1/0.95/12",
  "sha": "52bafe127d1be1815da68039de610dcc2d6f399de4a4bb7eddf30b7588224a2c"
 },
 "ank/01": {
  "text": "안킬로사우루스 안키의 꼬리에는 큰 망치가 있어요.",
  "cfg": "F1/0.95/12",
  "sha": "84e1f705391df29ff8e1295c8bc7d8a1414685a92e59d84952ab5fa6c495802c"
 },
 "ank/02": {
  "text": "친구 스테가 돌탑을 쌓고 있었어요. “하나, 둘, 셋!”",
  "cfg": "F1/0.95/12",
  "sha": "2b6e225556af97282cee2e6a5877ea6657bb6a5fdcab9077c90672f4e2995127"
 },
 "ank/03": {
  "text": "“나도 같이 놀래!” 안키가 신나서 꼬리를 흔들었어요.",
  "cfg": "F1/0.95/12",
  "sha": "c39097396de8942ff55907f7661509937502987a1381e9c62d5212f109576fd3"
 },
 "ank/04": {
  "text": "그만 꼬리가 돌탑에 쾅! 부딪혔어요.",
  "cfg": "F1/0.95/12",
  "sha": "4a86c5e17a15d03b0e7048b22c0c1edeeea79611eaaed56c2f08ced8c248aa25"
 },
 "ank/05": {
  "text": "돌탑이 와르르 무너졌어요. 스테가 엉엉 울었어요.",
  "cfg": "F1/0.95/12",
  "sha": "1a901aa223ab3ffc5a84ded66dfad5495930f18559fa0f3cba835edc3ab8da73"
 },
 "ank/06": {
  "text": "안키는 깜짝 놀라 바위인 척 숨었어요.",
  "cfg": "F1/0.95/12",
  "sha": "adb4c5187e106ba7791f7317c4c227366547fb490300cbe7929bdb6ffe7f4d86"
 },
 "ank/07": {
  "text": "하지만 마음이 콩닥콩닥 불편했어요.",
  "cfg": "F1/0.95/12",
  "sha": "69d89bb4790d90ba0102208ccbf09bb05b6de2c64e6812c83aa9d612454d8a16"
 },
 "ank/08": {
  "text": "안키는 용기를 내어 말했어요. “스테야, 미안해.”",
  "cfg": "F1/0.95/12",
  "sha": "abda38a16aaa9f984435a74a35f2864f8748801d3ead5cfd6962914830dd67d2"
 },
 "ank/09": {
  "text": "“괜찮아! 우리 같이 다시 쌓자.” 둘은 더 높은 탑을 쌓았어요.",
  "cfg": "F1/0.95/12",
  "sha": "fc6833245860570582ec451ea3bca660ce317f91ce8d511721c5df499cfd250c"
 },
 "ank/10": {
  "text": "잘못했을 때는 “미안해” 하고 말해요. 그러면 다시 친구가 돼요.",
  "cfg": "F1/0.95/12",
  "sha": "61f70fab33b1e96ce32fa656d4ff3d96e8446eacdb67ae0db5d28ffd4045d303"
 },
 "ank/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "2eb041e8b530f69583111c8d469356996a3a5033aa85d08164d48f344f1151d5"
 },
 "bra/00": {
  "text": "목이 길쭉길쭉 브라키오사우루스",
  "cfg": "F1/0.95/12",
  "sha": "bcb03e605c903318c24b18396bdd90bae169d57ed1e392424e442221ea9637f0"
 },
 "bra/01": {
  "text": "브라키오사우루스 브라는 목이 아주 길어요.",
  "cfg": "F1/0.95/12",
  "sha": "dbf6595b9e4f13b21f229aba8f87d99b8debfb2743edcf3120667f8b52dd26b8"
 },
 "bra/02": {
  "text": "친구들과 숨바꼭질을 해요. “꼭꼭 숨어라!”",
  "cfg": "F1/0.95/12",
  "sha": "7f6172f27ef3d5795e3fc696dcc4e0b1c7690c8c2fe14b0053bd459e1a741a60"
 },
 "bra/03": {
  "text": "하지만 긴 목 때문에 금방 들켰어요. “브라 찾았다!”",
  "cfg": "F1/0.95/12",
  "sha": "416e7dd0a4b6f68a058ea347fd789273bafda901814c1bf86ade11e845783025"
 },
 "bra/04": {
  "text": "“내 목은 왜 이렇게 길까?” 브라는 속상했어요.",
  "cfg": "F1/0.95/12",
  "sha": "a8d467877718fd633473c59d830b4f5517a77cc09b8f081a72eba255e9be3401"
 },
 "bra/05": {
  "text": "어느 날 친구들은 배가 고팠어요. 땅에는 풀이 하나도 없었어요.",
  "cfg": "F1/0.95/12",
  "sha": "b9d13d704e9b8aa642dfe392e25db81dbe3bd8180a499259b9a9f91c516140cf"
 },
 "bra/06": {
  "text": "맛있는 잎은 높은 나무 꼭대기에만 있었어요.",
  "cfg": "F1/0.95/12",
  "sha": "9635bcaa739d4a3b79439d73cc3d149631258bac1befca516309653219e4a21f"
 },
 "bra/07": {
  "text": "“내가 따 줄게!” 브라가 목을 쭈욱 뻗었어요.",
  "cfg": "F1/0.95/12",
  "sha": "53be0a5b06157ab16f59ae1e3a600fda2ef0438d3d0c212deee672f2e1aabc06"
 },
 "bra/08": {
  "text": "잎이 후두둑 떨어졌어요. 모두 냠냠 맛있게 먹었어요.",
  "cfg": "F1/0.95/12",
  "sha": "a2bf4c81423ff919d3b787835956349d491448394cc7e58756177b839ca562e1"
 },
 "bra/09": {
  "text": "“브라야, 네 긴 목이 최고야!” 친구들이 말했어요.",
  "cfg": "F1/0.95/12",
  "sha": "fd55f5a78071d648b826e13c99e834978c387b11faab3f571fff2f1e4d0c6f9d"
 },
 "bra/10": {
  "text": "남과 다른 점이 나의 가장 멋진 점이에요.",
  "cfg": "F1/0.95/12",
  "sha": "f5046f346965ff02218daa47554e0d8f08775bc0b38fe1f3f736f5e3b63d7550"
 },
 "bra/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "c8ed7240e34ac9d5ac2be024e10743fd0b78ce4f7f9499f8caba53d6fd96b021"
 },
 "ela/00": {
  "text": "바닷속 헤엄 대장 엘라스모사우루스",
  "cfg": "F1/0.95/12",
  "sha": "6853675d174472434cbb073c468e2c5f20aa9132f01192ce2b1ea0c67ef6c155"
 },
 "ela/01": {
  "text": "엘라스모사우루스 엘라는 바다에 사는 수장룡이에요. 헤엄을 아주 잘 쳐요.",
  "cfg": "F1/0.95/12",
  "sha": "9d4ea543d4fc56d6c28925fb68bf79179f00a89a369d72f0619e3ce80cd28896"
 },
 "ela/02": {
  "text": "엄마가 말했어요. “엘라야, 멀리 가면 안 돼. 엄마 곁에서 놀자.”",
  "cfg": "F1/0.95/12",
  "sha": "089728e7f80a9ccc4a33f957f984bb3aefb0b05ab5998fe8a494204292647047"
 },
 "ela/03": {
  "text": "그때 반짝반짝 예쁜 물고기가 지나갔어요.",
  "cfg": "F1/0.95/12",
  "sha": "8f337284f878798d72589d625879ace3d186e27b20de2d747a0cbd3c6d17ae1d"
 },
 "ela/04": {
  "text": "“우와, 예쁘다!” 엘라는 물고기를 졸졸 따라갔어요.",
  "cfg": "F1/0.95/12",
  "sha": "c42985dffdc3c478c4f0f084c4d5bcfae2a3240bc88aa158dffd6db40c2c23a5"
 },
 "ela/05": {
  "text": "따라가다 보니 엄마가 보이지 않았어요.",
  "cfg": "F1/0.95/12",
  "sha": "271e447151eb39e9bb1460308060010c8f67d5ce44be832f1e27ffa3516dbee1"
 },
 "ela/06": {
  "text": "바닷속은 점점 어두워졌어요. 엘라는 무서웠어요.",
  "cfg": "F1/0.95/12",
  "sha": "da44ecb941c4886dce7b018811cf46497d3c21c8ad7ce7db199cae4e250d7d8f"
 },
 "ela/07": {
  "text": "엘라는 엄마 말이 생각났어요. “길을 잃으면 그 자리에서 엄마를 불러.”",
  "cfg": "F1/0.95/12",
  "sha": "6f64c557b4543c559a060cd17f77913e64c93a291b0815617ec7edb35c5b0c85"
 },
 "ela/08": {
  "text": "엘라는 꼼짝 않고 큰 소리로 불렀어요. “엄마! 엄마!”",
  "cfg": "F1/0.95/12",
  "sha": "92533477e4c2e4be21802857f3ec895d0f3a20f4b6a60a4320e6444239e8ca37"
 },
 "ela/09": {
  "text": "“엘라야!” 엄마가 쏜살같이 헤엄쳐 왔어요.",
  "cfg": "F1/0.95/12",
  "sha": "2ab5e410c68e9eb1a4cf84f0aa065405f93df4584f536df26f9663a6c29169d6"
 },
 "ela/10": {
  "text": "멀리 갈 때는 꼭 엄마에게 말해요. 엘라는 이제 엄마 곁에서 놀아요.",
  "cfg": "F1/0.95/12",
  "sha": "a636a12fffdf2b866e8b9f652b4accc33632223212ee32d71a624de93f647b74"
 },
 "ela/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "b7292c04bddabfea63b21f8315edc2f81b6a4f02fb1e118613c75736eaf4d3d5"
 },
 "igu/00": {
  "text": "골고루 냠냠 이구아노돈",
  "cfg": "F1/0.95/12",
  "sha": "8d714d5207125dc663972ccb47f9791de1dc61adcefdffbaa955acbc0fd22e0d"
 },
 "igu/01": {
  "text": "이구아노돈 이구는 달콤한 열매를 아주 좋아해요.",
  "cfg": "F1/0.95/12",
  "sha": "6276e8d1b26ed40908cced3d2d08d9ca56d684249ccb97b2fa10e8b0a7bf4551"
 },
 "igu/02": {
  "text": "엄마가 말했어요. “이구야, 초록 풀도 먹어 보렴.”",
  "cfg": "F1/0.95/12",
  "sha": "62969645636bca1a10a6523ab8d9415aaa20068276d607444425e09ab47862b2"
 },
 "igu/03": {
  "text": "“싫어! 풀은 맛없어!” 이구는 고개를 홱 돌렸어요.",
  "cfg": "F1/0.95/12",
  "sha": "88055d083e84e71fd558f9d9c9ff6d58c56fd6a81fec5678512cc3ee6d29ac23"
 },
 "igu/04": {
  "text": "이구는 날마다 열매만 먹었어요.",
  "cfg": "F1/0.95/12",
  "sha": "3f4259048abde060b9a0f1cd5c762858444b703760f3254f9684449253408f8a"
 },
 "igu/05": {
  "text": "그런데 달리기를 하면 금방 헉헉 숨이 찼어요.",
  "cfg": "F1/0.95/12",
  "sha": "7979f7e8a90b6f87483e9f8f32b2f80a0717aa86e416d9ce24eb7c1c1bc898e2"
 },
 "igu/06": {
  "text": "친구들은 씽씽 달리는데 이구만 꼴찌였어요.",
  "cfg": "F1/0.95/12",
  "sha": "fd0f72b9260a2e0ca5e9a111fca15ebd794da979b115c6bc50263ed8ab4ff751"
 },
 "igu/07": {
  "text": "배도 살살 아팠어요. “아이고, 배야.”",
  "cfg": "F1/0.95/12",
  "sha": "a2c177b1b9b91ee59a98df4e4f86c7aa0d2137b986bbc493e8006daefabb0db7"
 },
 "igu/08": {
  "text": "이구는 용기를 내어 풀을 한 입 먹어 봤어요.",
  "cfg": "F1/0.95/12",
  "sha": "05357c0f11f09ee466f5ff5da57e2600f07d6ca3accc9e9c069b771d1503d737"
 },
 "igu/09": {
  "text": "“어? 아삭아삭 맛있네!” 이구는 풀도 열매도 골고루 먹었어요.",
  "cfg": "F1/0.95/12",
  "sha": "96f03a9a2c7a24ebbdd70e7d902738d60b59ffd2840616d7379f35d77f0d717f"
 },
 "igu/10": {
  "text": "골고루 먹으면 몸이 튼튼해져요. 이제 이구도 씽씽 달려요!",
  "cfg": "F1/0.95/12",
  "sha": "43f8c4a1e24d69b2b63c88187ffd49df600d89d006863a7125aad45b35246c7a"
 },
 "igu/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "fd13e8a1298f0b69446c1816641e84b5930ff3ab6129d5eb137376af944e661d"
 },
 "pac/00": {
  "text": "머리가 단단한 파키케팔로사우루스",
  "cfg": "F1/0.95/12",
  "sha": "ba4779bbc85debdc565f5676332e9ff670934a8315d2cd551e79c48671ebbcd1"
 },
 "pac/01": {
  "text": "파키케팔로사우루스 파키는 머리가 아주 단단해요.",
  "cfg": "F1/0.95/12",
  "sha": "256bb0cb6446a5834338ce5c74a3943e9f9364713de825085f040c9917e0b0c3"
 },
 "pac/02": {
  "text": "파키는 화가 나면 머리로 쿵! 박치기를 했어요.",
  "cfg": "F1/0.95/12",
  "sha": "dd7f84edd48f416e457314be4a6fa2984a310e30d51d057446c88b767d63421c"
 },
 "pac/03": {
  "text": "어느 날 친구 토리가 파키의 열매를 가져갔어요.",
  "cfg": "F1/0.95/12",
  "sha": "9da9a878f00db9ef5afc273b82d56096ea58391736ebac2b619c862c3279defa"
 },
 "pac/04": {
  "text": "파키는 화가 나서 쿵! 박치기를 했어요. 토리가 엉엉 울었어요.",
  "cfg": "F1/0.95/12",
  "sha": "524a81ea91eb7488e4ae628fa340b71c729adbf0bfc67d9aa46ebaf304d888e4"
 },
 "pac/05": {
  "text": "친구들은 무서워서 파키와 놀지 않았어요.",
  "cfg": "F1/0.95/12",
  "sha": "8c201972402b67735184e92236b00b6e4fa4e0e7402d87ed009e606d88147bd4"
 },
 "pac/06": {
  "text": "엄마가 말했어요. “화가 날 땐 숨을 크게 쉬고 말로 해 보렴.”",
  "cfg": "F1/0.95/12",
  "sha": "27830e876d48d40be7e4e5c57cb8f1946f781f827e1edb40d0afd6248ba3bd29"
 },
 "pac/07": {
  "text": "다음 날, 안키가 파키의 꼬리를 꾹 밟았어요. “아야!”",
  "cfg": "F1/0.95/12",
  "sha": "8ab3cda017c78f8e32375ac49b5c39ff93b66f78b36a4f0f8b3737d763edd886"
 },
 "pac/08": {
  "text": "파키는 숨을 후우 쉬고 말했어요. “아파. 조심해 줘.”",
  "cfg": "F1/0.95/12",
  "sha": "0c9e0f5e4db4f6b8d4781c90fda93489fe776d3bccadab0000ccbf64bb2d2b90"
 },
 "pac/09": {
  "text": "“미안해, 파키야!” 둘은 다시 사이좋게 놀았어요.",
  "cfg": "F1/0.95/12",
  "sha": "c6d60ce5955ef20c1ab869167f78c55e6f87402b50cbf6bfe950c59a38d19b3e"
 },
 "pac/10": {
  "text": "화가 날 땐 말로 해요. 단단한 머리는 열매를 딸 때만 쿵!",
  "cfg": "F1/0.95/12",
  "sha": "1361f7c08d11e964085a3a95ffbbf8ae66bfe964eff61083f302c226ce950318"
 },
 "pac/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "0a9381e85777d761775c157207e8175998463dc8ee2e031c9eaa1e6088200044"
 },
 "par/00": {
  "text": "뿌우뿌우 나팔 부는 파라사우롤로푸스",
  "cfg": "F1/0.95/12",
  "sha": "dc1ad84932dbeed88f38f65ab613cc9145e0daceb6ac9e4f547f8ebeea332c55"
 },
 "par/01": {
  "text": "파라사우롤로푸스 파라는 머리에 긴 나팔이 있어요.",
  "cfg": "F1/0.95/12",
  "sha": "b1bd69b1326fe8ae7ceea038843dd37cf5259c59826df3096be7f26a54d330a8"
 },
 "par/02": {
  "text": "위험할 때 뿌우 하고 친구들에게 알려 줘요.",
  "cfg": "F1/0.95/12",
  "sha": "323b4a698260236ca5886824ca4594284d736a40316c529b38436318770e8131"
 },
 "par/03": {
  "text": "어느 날 파라는 심심했어요. “장난을 쳐 볼까?”",
  "cfg": "F1/0.95/12",
  "sha": "e257dfb5c1e95d7572dae3b966a84962d1cd423b280d39aa60ea8e4ebe9698c0"
 },
 "par/04": {
  "text": "“뿌우! 무서운 공룡이 온다!” 친구들이 후다닥 숨었어요.",
  "cfg": "F1/0.95/12",
  "sha": "b962f672587a1072ad88039744dc0c82fb288345682399e7d85ce6e8b141a7af"
 },
 "par/05": {
  "text": "“히히, 거짓말이야!” 파라는 깔깔 웃었어요. 친구들은 화가 났어요.",
  "cfg": "F1/0.95/12",
  "sha": "fed86dd9446d46203cbbbd491143ca5b24e700d6ddacc1ee494e400829e76f20"
 },
 "par/06": {
  "text": "그런데 진짜로 화산이 우르릉 쿵쾅 흔들렸어요.",
  "cfg": "F1/0.95/12",
  "sha": "8c6ebd5394cf1c167606ee328f7c5f3fdadac5e6e63c5aac97ef59191e1f3e04"
 },
 "par/07": {
  "text": "“뿌우! 화산이야! 도망가!” 하지만 아무도 믿지 않았어요.",
  "cfg": "F1/0.95/12",
  "sha": "304db9f721e183f839ef89ddc7c569ed0b42823b545876b9a1732094fac8cf03"
 },
 "par/08": {
  "text": "파라는 친구들에게 달려갔어요. “이번엔 진짜야! 거짓말해서 미안해!”",
  "cfg": "F1/0.95/12",
  "sha": "5878e7e75937c8fc01f289a7294b3f0020fe0a9b163e4fe12845aff7b17f3c3f"
 },
 "par/09": {
  "text": "모두 함께 달려서 멀리멀리 피했어요.",
  "cfg": "F1/0.95/12",
  "sha": "0db1ce10814996822b36aeef53aea7b421a96a6d4434cdcf5f31bcb6e8d587a0"
 },
 "par/10": {
  "text": "거짓말을 하면 아무도 믿지 않아요. 파라는 이제 참말만 해요.",
  "cfg": "F1/0.95/12",
  "sha": "81e1502e3bf81c4452261ca726e1cc29133e44cbf05b74d13122908d7253798e"
 },
 "par/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "56c559e50b620442279c84baedec1de363b24655a1477912225cba4e0a19d230"
 },
 "pte/00": {
  "text": "하늘을 훨훨 나는 프테라노돈",
  "cfg": "F1/0.95/12",
  "sha": "f9900892ac9982bd344456c72d71f7c4fe97bf77ff1653f2dc9773a6618d2c9a"
 },
 "pte/01": {
  "text": "프테라노돈 프테는 하늘을 나는 익룡이에요. 하지만 아직 날지 못해요.",
  "cfg": "F1/0.95/12",
  "sha": "7615ca9db4630ca8d10ab5de1265ddd7acb6353fa36afd7ebb2ff3f8018596db"
 },
 "pte/02": {
  "text": "엄마는 하늘을 훨훨 날아요. “프테야, 너도 할 수 있어!”",
  "cfg": "F1/0.95/12",
  "sha": "3cbbf65a8f4130db8cfb3a786310c344be0c0af5c12c450cec635d977fa5ed3c"
 },
 "pte/03": {
  "text": "프테는 바위 끝에 섰어요. 다리가 후들후들 떨렸어요.",
  "cfg": "F1/0.95/12",
  "sha": "f02151a49f0a965d8f4c8c0db5ec4d0b18f7d0b144d5c593e65e1e82069a0c5b"
 },
 "pte/04": {
  "text": "“하나, 둘, 셋!” 프테가 날개를 활짝 폈어요.",
  "cfg": "F1/0.95/12",
  "sha": "bc5c33ec7da193acf2bca05e8ba467ee98c1b7501285eeba4a4828d67c199445"
 },
 "pte/05": {
  "text": "하지만 풍덩! 바다에 빠지고 말았어요.",
  "cfg": "F1/0.95/12",
  "sha": "f5a8fdc0fb59aaa577f46579f1ca95137d2773598f33a24337b5521205a26a07"
 },
 "pte/06": {
  "text": "프테는 다시 올라갔어요. 또 풍덩! 또 풍덩!",
  "cfg": "F1/0.95/12",
  "sha": "3ded5259045b412cb62da5195531a7191eee34470659d06abd7c46bdb9d39eb9"
 },
 "pte/07": {
  "text": "“난 못 해.” 프테는 눈물이 났어요.",
  "cfg": "F1/0.95/12",
  "sha": "4eaa9bcbf12d9842bf54b477e1dc4f95f1adf165e56b6c349d87dbf3d6f18564"
 },
 "pte/08": {
  "text": "“한 번만 더 해 보자!” 프테는 힘껏 날개를 저었어요.",
  "cfg": "F1/0.95/12",
  "sha": "c7645e46337597aaf6eb32e139d9de742ed677a2f7f4f3a3c216af8d189d8f4e"
 },
 "pte/09": {
  "text": "우와! 프테가 바람을 타고 날았어요!",
  "cfg": "F1/0.95/12",
  "sha": "b6f3994381643b84498f361555a3e6851236f3288d2c2edf80fda1c5fbfa4538"
 },
 "pte/10": {
  "text": "넘어져도 다시 하면 할 수 있어요. 프테는 이제 하늘을 훨훨 날아요.",
  "cfg": "F1/0.95/12",
  "sha": "bcf5769093ec593249198cb8b4719c577982aa60224fdf5469db65583283ec1b"
 },
 "pte/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "dbb004923897cb8f09fe9f840d28ce1a5d0044a9c70c5f73402d7d2d180a63c0"
 },
 "rap/00": {
  "text": "달리기 선수 벨로키랍토르",
  "cfg": "F1/0.95/12",
  "sha": "b80e591f7346ab033fc5dc855b903a9f097f72bd9ea9c83d96c3c10ea348b4cd"
 },
 "rap/01": {
  "text": "벨로키랍토르 랩토는 달리기가 아주 빨라요.",
  "cfg": "F1/0.95/12",
  "sha": "8d84afab2b2745b62db5983c89f39bb509a15da249efdb6a6244810c1ba5cab8"
 },
 "rap/02": {
  "text": "랩토는 무엇이든 “내가 먼저!” 하고 달려갔어요.",
  "cfg": "F1/0.95/12",
  "sha": "760eb5a5948fe29688be0786e4e76c09528cdd7ef67fda0accb820bd9b67aaeb"
 },
 "rap/03": {
  "text": "물을 마실 때도 친구들 앞으로 쏙 끼어들었어요.",
  "cfg": "F1/0.95/12",
  "sha": "b3aa60c4c7f68c2f11473074dd1bcd5cb41ae4047dfbbb9e898bbae850be68e6"
 },
 "rap/04": {
  "text": "열매를 딸 때도 맨 앞으로 달려갔어요. 친구들은 속상했어요.",
  "cfg": "F1/0.95/12",
  "sha": "2ff21d8468541353fac3b0024c49da6d31088ddc67aaba74ddd8be1996dbe6df"
 },
 "rap/05": {
  "text": "어느 날 폭포 미끄럼틀에 긴 줄이 생겼어요.",
  "cfg": "F1/0.95/12",
  "sha": "437b83023cc6ce74bf4b25f50bae0804a939abe7e62a20a38af12b32b7aa8198"
 },
 "rap/06": {
  "text": "“내가 먼저!” 랩토가 맨 앞으로 뛰어들었어요.",
  "cfg": "F1/0.95/12",
  "sha": "d4a84f4cace9e5df503b8c0610b810af413367fbe2cf4b8729ccf482c1360c8b"
 },
 "rap/07": {
  "text": "그만 아기 토리와 쾅! 부딪혔어요. 토리가 엉엉 울었어요.",
  "cfg": "F1/0.95/12",
  "sha": "33e06440bc980735812efc70ad9965bdee9bb49506d3708cbdfa12bd9140b795"
 },
 "rap/08": {
  "text": "랩토는 깜짝 놀랐어요. “미안해. 내가 새치기해서 그래.”",
  "cfg": "F1/0.95/12",
  "sha": "6db72d89fad4b8748d33590b5010a93376c6d43255479519c6078ce626ed1269"
 },
 "rap/09": {
  "text": "랩토는 맨 뒤로 가서 줄을 섰어요. 기다리면서 친구와 이야기도 했어요.",
  "cfg": "F1/0.95/12",
  "sha": "ea067da44fff02c4ce0d4dc15792338b8e2c8aebb8b1415f3d67c17228bc08f6"
 },
 "rap/10": {
  "text": "차례를 지키면 모두 즐거워요. 드디어 랩토 차례!",
  "cfg": "F1/0.95/12",
  "sha": "fca808f6e7d54f2476c4b51bf5e28e52b5841653596bf3a24c872832eddd6b22"
 },
 "rap/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "90ff1be3801061cfed4e26ec6faa11ada8a6de1758e20b7e07e1970146186f1a"
 },
 "spi/00": {
  "text": "물고기 잡기 대장 스피노사우루스",
  "cfg": "F1/0.95/12",
  "sha": "aae7c87273d47a94ba6a5ef227ec31ab5bceefaaa8ef513cb5fb03799770dbb6"
 },
 "spi/01": {
  "text": "스피노사우루스 스피노는 물고기 잡기 대장이에요.",
  "cfg": "F1/0.95/12",
  "sha": "5eaf0d5c770509d613b6a490532d02c441b00fad9e1ba7a06e924d679f2a6e28"
 },
 "spi/02": {
  "text": "오늘은 물고기를 아주 많이 잡았어요. “우와, 신난다!”",
  "cfg": "F1/0.95/12",
  "sha": "b5e8ad372c41bb3c0e327075e00a658138d3cbd78c8d62e7b8930f307be9302d"
 },
 "spi/03": {
  "text": "친구들이 다가왔어요. “스피노야, 하나만 나눠 줄래?”",
  "cfg": "F1/0.95/12",
  "sha": "e925bf10690e73eaa149d2af4fc2f3d5e5db00109b88867088c060b5fc736c61"
 },
 "spi/04": {
  "text": "“싫어! 전부 다 내 거야!” 스피노가 소리쳤어요.",
  "cfg": "F1/0.95/12",
  "sha": "7aac1e57466ab4536fa4a9c2eb36e5ce171f85c1723bb7342a1e89280166ccd1"
 },
 "spi/05": {
  "text": "친구들은 힘없이 돌아갔어요.",
  "cfg": "F1/0.95/12",
  "sha": "64cfa4a882c39657c2c06b692f47b9caf0f6949fd8d4ebd126843f3bea5003d5"
 },
 "spi/06": {
  "text": "스피노는 혼자 냠냠 먹었어요. 그런데 하나도 맛이 없었어요.",
  "cfg": "F1/0.95/12",
  "sha": "f39e1e8e492a39e73857136fed7210f1ae6728571224f1110f0154d6172f3764"
 },
 "spi/07": {
  "text": "스피노는 생각했어요. “혼자 먹으니까 심심해.”",
  "cfg": "F1/0.95/12",
  "sha": "7e0f1b55b0a7c2c4c80873f6ee7332d71d5f655b4d7e9184a89b5e8a1fcbd8a5"
 },
 "spi/08": {
  "text": "스피노는 물고기를 들고 달려갔어요. “얘들아, 같이 먹자!”",
  "cfg": "F1/0.95/12",
  "sha": "ea40c83c213a62f0301099d753ceb919e42d5432eee42bf8da79f1cc1a467c83"
 },
 "spi/09": {
  "text": "친구들도 맛있는 열매를 가져왔어요. 모두 함께 냠냠!",
  "cfg": "F1/0.95/12",
  "sha": "9dd57aedfb648eb73efa4ea50c776fc1f4303148e31f7d5ce381158d865b6c55"
 },
 "spi/10": {
  "text": "나눠 먹으면 더 맛있어요. 마음도 배도 든든해요.",
  "cfg": "F1/0.95/12",
  "sha": "1d9b346850aacbf06ca521b9da83f1bc0624de7f4c71173788cca8cb55cd177e"
 },
 "spi/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "affaaf3801427307544100a858c59f42898f2e4e10355e5be6a220cb29c53f10"
 },
 "ste/00": {
  "text": "등이 뾰족뾰족 스테고사우루스",
  "cfg": "F1/0.95/12",
  "sha": "8620fd7953484f6e66962fe499260f7781c6af0d144dcb8d7533b26b4c83581d"
 },
 "ste/01": {
  "text": "스테고사우루스 스테는 걸음이 느려요.",
  "cfg": "F1/0.95/12",
  "sha": "39561caac8a0ea8af294266ec289364e7a1f1022075812474fe19defcd1dcb55"
 },
 "ste/02": {
  "text": "“스테야, 빨리 와! 언덕까지 달리기하자!”",
  "cfg": "F1/0.95/12",
  "sha": "9d60761b61088f1a2f55b0f5cc236a786fff5e847940792af17df25332087df1"
 },
 "ste/03": {
  "text": "친구들은 벌써 저 멀리 가 버렸어요.",
  "cfg": "F1/0.95/12",
  "sha": "52a9ff4e8ea38d02d40370f4f36d80f3f79f4ec96d8c7b06ae0cffa1e66103f3"
 },
 "ste/04": {
  "text": "스테는 천천히 걸으며 꽃도 보고 나비도 만났어요.",
  "cfg": "F1/0.95/12",
  "sha": "27b6d5820418db7b23fa692912885968ea00b3ec9fdef557d8dc4d1ff6ff6f01"
 },
 "ste/05": {
  "text": "그런데 갑자기 비가 쏟아졌어요.",
  "cfg": "F1/0.95/12",
  "sha": "52f0d7ea79e354ff18c483cb7bc18c95fb5fc487d0b5bbbbbc4e80889495d51d"
 },
 "ste/06": {
  "text": "친구들은 비를 맞고 오들오들 떨었어요.",
  "cfg": "F1/0.95/12",
  "sha": "3d44dbc9f2f1b4b9777e5d0750ad8faa5c6e5f9c8aa5a8efb14eb96d68f49477"
 },
 "ste/07": {
  "text": "“얘들아, 내 등 밑으로 들어와!” 스테가 말했어요.",
  "cfg": "F1/0.95/12",
  "sha": "d1e2ba2fa0a5a9428f324b6c1e59db1746cae3acb9e3c37e482cda91c99920e9"
 },
 "ste/08": {
  "text": "스테의 등은 커다란 우산이 되었어요.",
  "cfg": "F1/0.95/12",
  "sha": "7fea10c8be3eee0618eed8c4efe7145c8aca31fdadfba85c947b82fce33db1f8"
 },
 "ste/09": {
  "text": "비가 그치고 무지개가 떴어요. “스테야, 고마워!”",
  "cfg": "F1/0.95/12",
  "sha": "2d99d1f27e3c4d321a74021703e9e1b39a4f8741e888dac22f7ec5099f4b1b7a"
 },
 "ste/10": {
  "text": "천천히 가도 괜찮아요. 함께 가면 더 즐거우니까요.",
  "cfg": "F1/0.95/12",
  "sha": "133170e7a679ecc3964d12d28588d263fde0b439a4404c8fc4f4cc5994e44dce"
 },
 "ste/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "9920ab35f0c5c2c5df32c7399dc333a90ff4fed1713ab3dff62a8a80d6d98fd9"
 },
 "trex/00": {
  "text": "힘세고 멋진 티라노사우루스",
  "cfg": "F1/0.95/12",
  "sha": "3d1cc28c392b6332ac71b97dd3459399b7f8c9ba96f8f25129a72a68ea433322"
 },
 "trex/01": {
  "text": "티라노사우루스 티노는 힘이 아주 세요.",
  "cfg": "F1/0.95/12",
  "sha": "2ea3b17fff1f396106e03a0742dd63da2b4dbf280b94c8700f665234c9c808d8"
 },
 "trex/02": {
  "text": "“같이 놀자! 크아앙!” 티노가 큰 소리로 외쳤어요.",
  "cfg": "F1/0.95/12",
  "sha": "70eae613d7541cc462aab323618dd8544fb1a7848648cb6291eeaa65d54ede3f"
 },
 "trex/03": {
  "text": "친구들은 깜짝 놀라 도망갔어요.",
  "cfg": "F1/0.95/12",
  "sha": "7d64097c64f955c95aa79d069a811cb95002ba2a3d44acadb5eaa89bb0eb564e"
 },
 "trex/04": {
  "text": "티노는 혼자 남았어요. 너무 심심했어요.",
  "cfg": "F1/0.95/12",
  "sha": "45682f24d626ca1864c813e5d375fd8753d39ff92a89ab4c57c0bda0568e2ce6"
 },
 "trex/05": {
  "text": "그때 어디선가 작은 소리가 들렸어요. “도와줘!”",
  "cfg": "F1/0.95/12",
  "sha": "81dd18238a6b9517b69eda3ab65bc77a825f0ad5988dbdb8b782faf4dd1cc2bd"
 },
 "trex/06": {
  "text": "아기 트리케라톱스가 큰 바위 사이에 끼었어요.",
  "cfg": "F1/0.95/12",
  "sha": "341ec16d53d4ff3d9ae670cacdca89beb0020848e4b0fd08e802161945b406ec"
 },
 "trex/07": {
  "text": "“내가 도와줄게!” 티노가 바위를 영차 밀었어요.",
  "cfg": "F1/0.95/12",
  "sha": "fb07d315a9413794a72d07aabedae231054a5ffa2cdd18fc7972eeb7c7be6271"
 },
 "trex/08": {
  "text": "바위가 데굴데굴 굴러갔어요. 아기가 쏙 나왔어요!",
  "cfg": "F1/0.95/12",
  "sha": "9e041d6ed41661659f69909556a29659c85923e11f35cb8215b193204730eba6"
 },
 "trex/09": {
  "text": "“고마워, 티노!” 친구들이 모두 달려왔어요.",
  "cfg": "F1/0.95/12",
  "sha": "deef88bd890fe704e998db9244cbec90bf49d90497b3523dd86904902e32a26e"
 },
 "trex/10": {
  "text": "힘은 친구를 도울 때 가장 멋져요.",
  "cfg": "F1/0.95/12",
  "sha": "7408611597a455b7c1d908b3579e048cd034e07c1e8201ad3fbcbb0f03c01cff"
 },
 "trex/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "4ce6805e24bf9034a1f62552295ed150c9ee27c08b9da72db005fb60d07e6e6b"
 },
 "tri/00": {
  "text": "뿔이 세 개! 씩씩한 트리케라톱스",
  "cfg": "F1/0.95/12",
  "sha": "f41bd8e17ca6f5846750689b37220e81fa65ed2b9f39b247565072a241764dfe"
 },
 "tri/01": {
  "text": "트리케라톱스 토리는 겁이 많아요. 나뭇잎 소리에도 깜짝!",
  "cfg": "F1/0.95/12",
  "sha": "d5075c70e415ae7eefb17a75e8d5fb7b5a015e7c787172d8c6a2507f2c4b9ae7"
 },
 "tri/02": {
  "text": "엄마가 말했어요. “토리야, 동생 알을 잘 지켜 주렴.”",
  "cfg": "F1/0.95/12",
  "sha": "f5b5153959486332a0f607716490c2bbc0c2dcfb0a0479b03b27e028951a3c9f"
 },
 "tri/03": {
  "text": "토리는 알 옆에 꼭 붙어 있었어요.",
  "cfg": "F1/0.95/12",
  "sha": "7f1e0a9f21a4af15bcc3d1791515aaadae4f2ad970d391486dcfafde67035959"
 },
 "tri/04": {
  "text": "그런데 쿵, 쿵! 큰 발소리가 들렸어요.",
  "cfg": "F1/0.95/12",
  "sha": "c6046f6e7ca7c00474efa22e43e781d8be43fa92210585b4fbf268ef47c6a17c"
 },
 "tri/05": {
  "text": "배고픈 티라노사우루스가 나타났어요!",
  "cfg": "F1/0.95/12",
  "sha": "da0dd9248a40ca2eb57b990c1ba65f63a3322ec6d40f804e1850f73df34e3449"
 },
 "tri/06": {
  "text": "토리는 다리가 덜덜 떨렸어요. 하지만 도망가지 않았어요.",
  "cfg": "F1/0.95/12",
  "sha": "de7d208ad30c65658e8874809c4a87b4bcf252fa2e42ced1fc310c8ee284fb31"
 },
 "tri/07": {
  "text": "“내 동생이야! 안 돼!” 토리가 뿔을 번쩍 들었어요.",
  "cfg": "F1/0.95/12",
  "sha": "cece6bf2af717dc50b5bef0f19c93b2f7370aacbdda5f7d90e9d68b6b02e7b05"
 },
 "tri/08": {
  "text": "티라노사우루스는 깜짝 놀라 돌아갔어요.",
  "cfg": "F1/0.95/12",
  "sha": "ec8cf7ad75e985fd3f9f2fbb15bb7d74af78f55a323bf4f27dd9982dad193dd5"
 },
 "tri/09": {
  "text": "빠지직! 알에서 동생이 나왔어요.",
  "cfg": "F1/0.95/12",
  "sha": "ccc8919a04222ada55210ea2bf5eef453412c684897e9c6e628e1a12e5df0726"
 },
 "tri/10": {
  "text": "무서워도 용기를 내면 소중한 것을 지킬 수 있어요.",
  "cfg": "F1/0.95/12",
  "sha": "6605de478e6775fd44ba1df5d4b6d5dddfcd2ba0bb2b149abf592e573cbec3d5"
 },
 "tri/11": {
  "text": "끝! 참 잘했어요.",
  "cfg": "F1/0.95/12",
  "sha": "4b354ff3bd106b75465b97337c9eb9193fe40ea52e01020146bf77694eb039ba"
 }
}